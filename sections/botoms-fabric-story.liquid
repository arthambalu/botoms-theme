{%- liquid
  assign fabrics = shop.metaobjects.fabric_guide.values
-%}

{%- if fabrics.size > 0 -%}
  <div
    class="botoms-fabrics"
    style="--fabrics-padding-top: {{ section.settings.padding-block-start }}px; --fabrics-padding-bottom: {{ section.settings.padding-block-end }}px;"
  >
    <div class="botoms-fabrics__inner">
      <div class="botoms-fabrics__intro">
        {%- if section.settings.heading != blank -%}
          <h2 class="botoms-fabrics__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="botoms-fabrics__text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      <ul class="botoms-fabrics__list">
        {%- for fabric in fabrics limit: 4 -%}
          {%- assign fabric_handle = 'fabric-' | append: fabric.system.handle -%}
          {%- assign fabric_collection = collections[fabric_handle] -%}
          {%- assign fabric_name_lower = fabric.name.value | downcase -%}
          <li class="botoms-fabrics__item">
            {%- if fabric.image.value != blank -%}
              <span class="botoms-fabrics__swatch">
                {{ fabric.image.value | image_url: width: 160, height: 160, crop: 'center' | image_tag: alt: '', loading: 'lazy' }}
              </span>
            {%- endif -%}
            <h3 class="botoms-fabrics__name">{{ fabric.name.value }}</h3>
            {%- if fabric.composition.value != blank -%}
              <p class="botoms-fabrics__composition">{{ fabric.composition.value }}</p>
            {%- endif -%}
            {%- if fabric.description.value != blank -%}
              <p class="botoms-fabrics__description">{{ fabric.description.value }}</p>
            {%- endif -%}
            {%- if fabric_collection != blank and fabric_collection.products_count > 0 -%}
              <a class="botoms-fabrics__link" href="{{ fabric_collection.url }}">
                {{- 'botoms.fabric_story.shop' | t: fabric: fabric_name_lower -}}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .botoms-fabrics {
    padding: var(--fabrics-padding-top) 16px var(--fabrics-padding-bottom);
    background-color: var(--botoms-butterfly);
    color: var(--botoms-ink);
  }

  .botoms-fabrics__inner {
    max-width: var(--page-width, 1200px);
    margin-inline: auto;
  }

  .botoms-fabrics__intro {
    max-width: 560px;
    margin-bottom: 24px;
  }

  .botoms-fabrics__heading {
    margin: 0 0 8px;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
    line-height: 1.2;
  }

  .botoms-fabrics__text {
    font-size: 1rem;
    line-height: 1.55;
  }

  .botoms-fabrics__text p {
    margin: 0;
  }

  .botoms-fabrics__list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .botoms-fabrics__item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px;
    border-radius: 12px;
    background-color: var(--botoms-cream);
  }

  .botoms-fabrics__swatch {
    display: block;
    width: 56px;
    height: 56px;
    margin-bottom: 6px;
    overflow: hidden;
    border-radius: 50%;
  }

  .botoms-fabrics__swatch img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .botoms-fabrics__name {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 1.25rem;
  }

  .botoms-fabrics__composition {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--botoms-forest);
  }

  .botoms-fabrics__description {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--botoms-muted-ink);
  }

  .botoms-fabrics__link {
    margin-top: auto;
    padding-top: 8px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--botoms-forest);
    text-underline-offset: 3px;
  }

  @media screen and (min-width: 750px) {
    .botoms-fabrics {
      padding-inline: 40px;
    }

    .botoms-fabrics__list {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Botoms fabric story",
  "tag": "section",
  "class": "section-botoms-fabric-story",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows your Fabric guide entries (Content → Metaobjects). Each links to its fabric collection, e.g. fabric-cotton-stretch."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Know your fabric"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Every Botoms piece starts with the fabric. Here is what each one feels like, so you can choose for your day.</p>"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [{ "name": "Botoms fabric story" }]
}
{% endschema %}
