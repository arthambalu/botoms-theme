<div
  class="botoms-tiles"
  style="--tiles-padding-top: {{ section.settings.padding-block-start }}px; --tiles-padding-bottom: {{ section.settings.padding-block-end }}px; --tiles-count: {{ section.settings.collections.count | at_least: 1 }};"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="botoms-tiles__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <ul class="botoms-tiles__list">
    {%- for tile_collection in section.settings.collections -%}
      <li class="botoms-tiles__item">
        <a class="botoms-tiles__link" href="{{ tile_collection.url }}">
          <span class="botoms-tiles__frame">
            {%- if tile_collection.featured_image != blank -%}
              {{
                tile_collection.featured_image
                | image_url: width: 800
                | image_tag:
                  widths: '300, 450, 600, 800',
                  sizes: '(min-width: 750px) 30vw, 40vw',
                  loading: 'lazy',
                  alt: '',
                  class: 'botoms-tiles__image'
              }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'botoms-tiles__image' }}
            {%- endif -%}
          </span>
          <span class="botoms-tiles__title">{{ tile_collection.title }}</span>
          <span class="botoms-tiles__count">
            {{- 'botoms.card_switcher.styles_count' | t: count: tile_collection.products_count -}}
          </span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .botoms-tiles {
    padding: var(--tiles-padding-top) 0 var(--tiles-padding-bottom);
    background-color: var(--botoms-cream);
  }

  .botoms-tiles__heading {
    margin: 0 0 20px;
    padding-inline: 16px;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
    line-height: 1.2;
    color: var(--botoms-ink);
  }

  .botoms-tiles__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 40vw;
    gap: 12px;
    margin: 0;
    padding: 0 16px 4px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 16px;
    scrollbar-width: none;
  }

  .botoms-tiles__list::-webkit-scrollbar {
    display: none;
  }

  .botoms-tiles__item {
    scroll-snap-align: start;
  }

  .botoms-tiles__link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: var(--botoms-ink);
    text-decoration: none;
  }

  .botoms-tiles__frame {
    display: block;
    aspect-ratio: 3 / 4;
    margin-bottom: 8px;
    overflow: hidden;
    border-radius: 12px;
    background-color: var(--botoms-photo-white);
  }

  .botoms-tiles__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .botoms-tiles__link:hover .botoms-tiles__image {
    transform: scale(1.03);
  }

  .botoms-tiles__link:focus-visible {
    outline: 2px solid var(--botoms-forest);
    outline-offset: 4px;
    border-radius: 12px;
  }

  .botoms-tiles__title {
    font-weight: 500;
    font-size: 1rem;
  }

  .botoms-tiles__count {
    font-size: 0.875rem;
    color: var(--botoms-muted-ink);
  }

  @media screen and (min-width: 750px) {
    .botoms-tiles__heading,
    .botoms-tiles__list {
      max-width: var(--page-width, 1200px);
      margin-inline: auto;
      padding-inline: 40px;
    }

    .botoms-tiles__list {
      grid-auto-flow: row;
      grid-template-columns: repeat(min(var(--tiles-count), 4), minmax(0, 1fr));
      gap: 24px;
      overflow: visible;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .botoms-tiles__image {
      transition: none;
    }

    .botoms-tiles__link:hover .botoms-tiles__image {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Botoms shop by type",
  "tag": "section",
  "class": "section-botoms-type-tiles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by type"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "limit": 8,
      "info": "Only add product types you have in stock."
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [{ "name": "Botoms shop by type" }]
}
{% endschema %}
