{%- comment -%}
  Home closing: a strip of short brand values, then an oversized wordmark sign-off.
{%- endcomment -%}

<div class="botoms-signoff">
  {%- if section.blocks.size > 0 -%}
    <ul class="botoms-signoff__strip" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          {%- assign value_number = forloop.index | prepend: '0' | slice: -2, 2 -%}
          {{ value_number }} / {{ block.settings.text }}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  <div class="botoms-signoff__main">
    {%- if section.settings.eyebrow != blank -%}
      <p class="botoms-signoff__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <p class="botoms-signoff__wordmark" aria-hidden="true">{{ section.settings.wordmark }}</p>
    <div class="botoms-signoff__aside">
      {%- if section.settings.tagline != blank -%}
        <p class="botoms-signoff__tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a class="botoms-signoff__link" href="{{ section.settings.link | default: routes.all_products_collection_url }}">
          {{- section.settings.link_label }} <span aria-hidden="true">↗</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .botoms-signoff {
    background: var(--botoms-forest);
    color: var(--botoms-cream);
  }

  .botoms-signoff__strip {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    justify-content: space-between;
    margin: 0;
    padding: 20px 16px;
    border-block: 1px solid rgb(251 248 244 / 0.16);
    background: var(--botoms-ink);
    font-size: 12px;
    list-style: none;
  }

  .botoms-signoff__main {
    display: grid;
    gap: 16px;
    padding: 48px 16px 40px;
  }

  .botoms-signoff__eyebrow {
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .botoms-signoff__wordmark {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: clamp(4rem, 23vw, 15rem);
    white-space: nowrap;
    font-weight: 400;
    line-height: 0.85;
    letter-spacing: -0.06em;
    text-transform: uppercase;
  }

  .botoms-signoff__aside {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }

  .botoms-signoff__tagline {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.375rem;
    font-style: italic;
  }

  .botoms-signoff__link {
    color: inherit;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .botoms-signoff__link:focus-visible {
    outline: 2px solid var(--botoms-pink-cherub);
    outline-offset: 3px;
  }

  @media screen and (min-width: 750px) {
    .botoms-signoff__strip {
      padding-inline: 40px;
    }

    .botoms-signoff__main {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 48px;
      align-items: end;
      padding: 64px 40px 56px;
    }

    .botoms-signoff__eyebrow {
      grid-column: 1 / -1;
    }

    .botoms-signoff__wordmark {
      font-size: min(15vw, 15rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Botoms sign-off",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Start from the bottom." },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "Botoms" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Where comfort meets style." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop all" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Thoughtful silhouettes" }]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Botoms sign-off",
      "blocks": [
        { "type": "value", "settings": { "text": "Thoughtful silhouettes" } },
        { "type": "value", "settings": { "text": "A palette with possibilities" } },
        { "type": "value", "settings": { "text": "Dress for yourself" } }
      ]
    }
  ]
}
{% endschema %}
