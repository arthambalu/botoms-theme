<div
  class="botoms-faq"
  style="--faq-padding-top: {{ section.settings.padding-block-start }}px; --faq-padding-bottom: {{ section.settings.padding-block-end }}px;"
>
  <div class="botoms-faq__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="botoms-faq__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="botoms-faq__list">
      {%- for block in section.blocks -%}
        <details class="botoms-faq__item" {{ block.shopify_attributes }}>
          <summary class="botoms-faq__question">{{ block.settings.question }}</summary>
          <div class="botoms-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if section.blocks.size > 0 -%}
  {%- capture faq_entities -%}
    {%- for block in section.blocks -%}
      {"@type":"Question","name":{{ block.settings.question | strip_html | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | strip | json }}}}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  {%- endcapture -%}
  <script type="application/ld+json">
    {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ faq_entities }}]}
  </script>
{%- endif -%}

{% stylesheet %}
  .botoms-faq {
    padding: var(--faq-padding-top) 16px var(--faq-padding-bottom);
    color: var(--botoms-ink);
  }

  .botoms-faq__inner {
    max-width: 760px;
    margin-inline: auto;
  }

  .botoms-faq__heading {
    margin: 0 0 16px;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem);
  }

  .botoms-faq__list {
    border-top: 1px solid var(--botoms-line);
  }

  .botoms-faq__item {
    border-bottom: 1px solid var(--botoms-line);
  }

  .botoms-faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 56px;
    padding: 14px 0;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }

  .botoms-faq__question::-webkit-details-marker {
    display: none;
  }

  .botoms-faq__question::after {
    content: '+';
    flex: 0 0 auto;
    font-size: 1.25rem;
    line-height: 1;
    color: var(--botoms-muted-ink);
  }

  .botoms-faq__item[open] .botoms-faq__question::after {
    content: '–';
  }

  .botoms-faq__question:focus-visible {
    outline: 2px solid var(--botoms-forest);
    outline-offset: 2px;
  }

  .botoms-faq__answer {
    padding: 0 0 16px;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--botoms-muted-ink);
  }

  .botoms-faq__answer p {
    margin: 0 0 8px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Botoms FAQ",
  "tag": "section",
  "class": "section-botoms-faq",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Botoms FAQ", "blocks": [{ "type": "question" }] }]
}
{% endschema %}
