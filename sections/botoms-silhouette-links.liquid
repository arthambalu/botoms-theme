{%- comment -%}
  Home: direct links into the range by silhouette (leggings, kurti pants, palazzo, activewear).
  Collections without products are skipped, so only what is in stock is shown.
{%- endcomment -%}

<div
  class="botoms-silhouettes"
  style="--silhouettes-padding-top: {{ section.settings.padding-block-start }}px; --silhouettes-padding-bottom: {{ section.settings.padding-block-end }}px;"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="botoms-silhouettes__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}
  <ul class="botoms-silhouettes__list" role="list">
    {%- for silhouette in section.settings.collections -%}
      {%- if silhouette.products_count > 0 -%}
        <li>
          <a class="botoms-silhouettes__link" href="{{ silhouette.url }}">
            <span class="botoms-silhouettes__name">{{ silhouette.title }}</span>
            <span class="botoms-silhouettes__count">
              {{- 'botoms.home.styles' | t: count: silhouette.products_count -}}
            </span>
            <span class="botoms-silhouettes__arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .botoms-silhouettes {
    padding: var(--silhouettes-padding-top) 16px var(--silhouettes-padding-bottom);
    color: var(--botoms-ink);
  }

  .botoms-silhouettes__heading {
    margin: 0 0 14px;
    font-family: var(--font-body--family);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .botoms-silhouettes__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .botoms-silhouettes__link {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-height: 64px;
    padding: 12px 36px 12px 16px;
    border: 1px solid var(--botoms-line);
    border-radius: 12px;
    background: var(--botoms-white);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .botoms-silhouettes__link:hover {
    border-color: var(--botoms-ink);
  }

  .botoms-silhouettes__link:focus-visible {
    outline: 2px solid var(--botoms-ink);
    outline-offset: 2px;
  }

  .botoms-silhouettes__name {
    font-size: 1rem;
    font-weight: 500;
  }

  .botoms-silhouettes__count {
    color: var(--botoms-muted-ink);
    font-size: 0.8125rem;
  }

  .botoms-silhouettes__arrow {
    position: absolute;
    top: 12px;
    right: 14px;
  }

  @media screen and (min-width: 750px) {
    .botoms-silhouettes {
      padding-inline: 40px;
    }

    .botoms-silhouettes__list {
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 12px;
    }

    .botoms-silhouettes__link {
      min-height: 76px;
      padding: 16px 40px 16px 20px;
    }

    .botoms-silhouettes__name {
      font-size: 1.125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .botoms-silhouettes__link {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Botoms silhouette links",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by silhouette" },
    { "type": "collection_list", "id": "collections", "label": "Collections", "limit": 8 },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "Botoms silhouette links" }]
}
{% endschema %}
