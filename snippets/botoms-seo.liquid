{%- doc -%}
  Botoms structured data that Horizon doesn't output: BreadcrumbList on product and collection pages.
  Shopify already outputs Organization and Product/ProductGroup; botoms-faq outputs FAQPage.

  @example
  {% render 'botoms-seo' %}
{%- enddoc -%}

{%- liquid
  assign crumb_collection = blank
  if template.name == 'product'
    assign crumb_collection = collection
    if crumb_collection == blank
      assign type_handle = product.type | handleize
      for candidate in product.collections
        if candidate.handle == type_handle
          assign crumb_collection = candidate
          break
        endif
      endfor
    endif
    if crumb_collection == blank
      for candidate in product.collections
        unless candidate.handle contains 'style-' or candidate.handle contains 'fabric-' or candidate.handle == 'all' or candidate.handle == 'frontpage'
          assign crumb_collection = candidate
          break
        endunless
      endfor
    endif
  elsif template.name == 'collection'
    assign crumb_collection = collection
  endif
-%}

{%- if template.name == 'product' or template.name == 'collection' -%}
  {%- capture crumbs -%}
    {"@type":"ListItem","position":1,"name":{{ shop.name | json }},"item":{{ shop.url | append: routes.root_url | json }}}
    {%- if crumb_collection != blank -%}
      ,{"@type":"ListItem","position":2,"name":{{ crumb_collection.title | json }},"item":{{ shop.url | append: crumb_collection.url | json }}}
    {%- endif -%}
    {%- if template.name == 'product' -%}
      {%- if crumb_collection != blank -%}{%- assign product_position = 3 -%}{%- else -%}{%- assign product_position = 2 -%}{%- endif -%}
      ,{"@type":"ListItem","position":{{ product_position }},"name":{{ product.title | json }},"item":{{ shop.url | append: product.url | json }}}
    {%- endif -%}
  {%- endcapture -%}
  <script type="application/ld+json">
    {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{{ crumbs }}]}
  </script>
{%- endif -%}
