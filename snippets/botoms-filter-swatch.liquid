{%- doc -%}
  Swatch for a colour filter value, read from the shop's Color entries (shopify--color-pattern)
  so the filter shows the exact product shade, or the fabric image when one is set.
  Outputs the same markup as Horizon's `swatch` snippet in filter mode.

  @param {string} name - The colour option value, e.g. "Olive"

  @example
  {% render 'botoms-filter-swatch', name: value.value %}
{%- enddoc -%}

{%- liquid
  assign colour_handle = name | handleize
  assign entry = shop.metaobjects['shopify--color-pattern'][colour_handle]
  if entry == blank
    for candidate in shop.metaobjects['shopify--color-pattern'].values
      if candidate.label.value == name
        assign entry = candidate
        break
      endif
    endfor
  endif

  assign swatch_value = null
  if entry.image.value != blank
    assign swatch_image_url = entry.image.value | image_url: width: 80
    assign swatch_value = 'url(' | append: swatch_image_url | append: ')'
  elsif entry.color.value != blank
    assign swatch_value = 'rgb(' | append: entry.color.value.rgb | append: ')'
  endif
-%}

<span
  class="swatch swatch--filter{% if swatch_value == null %} swatch--unavailable{% endif %}"
  style="--swatch-background: {{ swatch_value }};"
></span>
