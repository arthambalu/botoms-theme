{%- doc -%}
  Botoms cart drawer extras: free-delivery progress bar and "Complete your look" upsell.
  Settings live in Theme settings > Botoms cart.

  @param {string} part - 'progress' or 'upsell'

  @example
  {% render 'botoms-cart-extras', part: 'progress' %}
{%- enddoc -%}

{%- if part == 'progress' -%}
  {%- assign threshold = settings.botoms_free_shipping_threshold | default: 0 | times: 100 -%}
  {%- if threshold > 0 and cart.item_count > 0 -%}
    {%- liquid
      assign remaining = threshold | minus: cart.total_price
      assign percent = cart.total_price | times: 100 | divided_by: threshold | at_most: 100
      assign remaining_money = remaining | money
    -%}
    <div class="botoms-cart-progress">
      <p class="botoms-cart-progress__text">
        {%- if remaining > 0 -%}
          {{ 'botoms.cart.free_delivery_remaining' | t: amount: remaining_money }}
        {%- else -%}
          {{ 'botoms.cart.free_delivery_unlocked' | t }}
        {%- endif -%}
      </p>
      <div
        class="botoms-cart-progress__track"
        role="progressbar"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="{{ percent }}"
        aria-label="{{ 'botoms.cart.free_delivery_unlocked' | t | escape }}"
      >
        <span class="botoms-cart-progress__fill" style="width: {{ percent }}%;"></span>
      </div>
    </div>
  {%- endif -%}
{%- elsif part == 'upsell' -%}
  {%- liquid
    assign upsell_collection = settings.botoms_cart_upsell_collection
    assign upsell_limit = settings.botoms_cart_upsell_limit | default: 0
    assign in_cart = cart.items | map: 'product_id' | join: ',' | prepend: ',' | append: ','
    assign cart_size = blank
    for item in cart.items
      for option in item.options_with_values
        assign option_name = option.name | downcase
        if option_name == 'size'
          assign cart_size = option.value
          break
        endif
      endfor
      if cart_size != blank
        break
      endif
    endfor
  -%}

  {%- if upsell_collection != blank and upsell_limit > 0 and cart.item_count > 0 -%}
    {%- capture upsell_items -%}
      {%- assign shown = 0 -%}
      {%- for upsell_product in upsell_collection.products limit: 12 -%}
        {%- assign product_key = ',' | append: upsell_product.id | append: ',' -%}
        {%- if shown >= upsell_limit -%}{%- break -%}{%- endif -%}
        {%- unless in_cart contains product_key or upsell_product.available == false -%}
          {%- assign default_variant = upsell_product.first_available_variant -%}
          {%- if cart_size != blank -%}
            {%- for v in upsell_product.variants -%}
              {%- if v.available and v.options contains cart_size -%}
                {%- assign default_variant = v -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          <li class="botoms-upsell__item">
            <a class="botoms-upsell__image" href="{{ upsell_product.url }}" tabindex="-1" aria-hidden="true">
              {%- if upsell_product.featured_image != blank -%}
                {{ upsell_product.featured_image | image_url: width: 160 | image_tag: alt: '', loading: 'lazy' }}
              {%- endif -%}
            </a>
            <div class="botoms-upsell__body">
              <a class="botoms-upsell__title" href="{{ upsell_product.url }}">{{ upsell_product.title }}</a>
              <span class="botoms-upsell__price">{{ default_variant.price | money }}</span>
              <form class="botoms-upsell__form" data-upsell-form>
                {%- if upsell_product.has_only_default_variant -%}
                  <input type="hidden" name="id" value="{{ default_variant.id }}">
                {%- else -%}
                  <select
                    name="id"
                    class="botoms-upsell__select"
                    aria-label="{{ 'botoms.cart.upsell_size' | t: product: upsell_product.title | escape }}"
                  >
                    {%- for v in upsell_product.variants -%}
                      {%- if v.available -%}
                        <option value="{{ v.id }}"{% if v.id == default_variant.id %} selected{% endif %}>{{ v.title }}</option>
                      {%- endif -%}
                    {%- endfor -%}
                  </select>
                {%- endif -%}
                <button
                  type="submit"
                  class="botoms-upsell__add"
                  aria-label="{{ 'botoms.cart.upsell_add_label' | t: product: upsell_product.title | escape }}"
                >
                  {{- 'botoms.cart.upsell_add' | t -}}
                </button>
              </form>
            </div>
          </li>
          {%- assign shown = shown | plus: 1 -%}
        {%- endunless -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- if upsell_items != blank -%}
      <botoms-cart-upsell class="botoms-upsell" data-error="{{ 'botoms.cart.upsell_error' | t | escape }}">
        <p class="botoms-upsell__heading">{{ 'botoms.cart.upsell_heading' | t }}</p>
        <ul class="botoms-upsell__list">{{ upsell_items }}</ul>
        <p class="botoms-upsell__error" role="alert" data-error-message></p>
      </botoms-cart-upsell>
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .botoms-cart-progress {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 12px;
    padding: 12px var(--theme-drawer-padding, 20px);
    background-color: var(--botoms-butterfly);
    color: var(--botoms-ink);
  }

  .botoms-cart-progress__text {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .botoms-cart-progress__track {
    height: 6px;
    overflow: hidden;
    border-radius: 3px;
    background-color: var(--botoms-cream);
  }

  .botoms-cart-progress__fill {
    display: block;
    height: 100%;
    border-radius: 3px;
    background-color: var(--botoms-forest);
    transition: width 0.4s ease;
  }

  .botoms-upsell {
    display: block;
    margin-top: 16px;
    padding: 16px 0 8px;
    border-top: 1px solid var(--botoms-line);
  }

  .botoms-upsell__heading {
    margin: 0 0 12px;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 1.125rem;
    color: var(--botoms-ink);
  }

  .botoms-upsell__list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .botoms-upsell__item {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
  }

  .botoms-upsell__image {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 6px;
    background-color: var(--botoms-photo-white);
  }

  .botoms-upsell__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .botoms-upsell__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .botoms-upsell__title {
    overflow: hidden;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--botoms-ink);
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .botoms-upsell__price {
    font-size: 0.875rem;
    color: var(--botoms-muted-ink);
  }

  .botoms-upsell__form {
    display: flex;
    gap: 8px;
    margin-top: 4px;
  }

  .botoms-upsell__select {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 40px;
    padding: 6px 10px;
    border: 1px solid var(--botoms-control);
    border-radius: 4px;
    background-color: var(--botoms-white);
    color: var(--botoms-ink);
    font: inherit;
    font-size: 0.875rem;
  }

  .botoms-upsell__add {
    flex: 0 0 auto;
    min-height: 40px;
    padding: 6px 16px;
    border: 1px solid var(--botoms-pink-cherub);
    border-radius: 999px;
    background-color: var(--botoms-pink-cherub);
    color: var(--botoms-ink);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
  }

  .botoms-upsell__add[aria-busy='true'] {
    opacity: 0.6;
    cursor: progress;
  }

  .botoms-upsell__error {
    margin: 8px 0 0;
    font-size: 0.8125rem;
    color: var(--botoms-rose);
  }

  .botoms-upsell__error:empty {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .botoms-cart-progress__fill {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  class BotomsCartUpsell extends HTMLElement {
    connectedCallback() {
      this.addEventListener('submit', (event) => {
        const form = event.target.closest('[data-upsell-form]');
        if (!form) return;
        event.preventDefault();
        this.add(form);
      });
    }

    async add(form) {
      const button = form.querySelector('button[type="submit"]');
      const message = this.querySelector('[data-error-message]');
      const variantId = new FormData(form).get('id');
      if (!variantId || button.getAttribute('aria-busy') === 'true') return;

      button.setAttribute('aria-busy', 'true');
      message.textContent = '';

      const sectionIds = Array.from(document.querySelectorAll('cart-items-component'))
        .map((component) => component.dataset.sectionId)
        .filter(Boolean);

      try {
        const { CartLinesUpdateEvent } = await import('@shopify/events');
        const deferred = CartLinesUpdateEvent.createPromise();
        this.dispatchEvent(
          new CartLinesUpdateEvent({
            action: 'add',
            context: 'product',
            lines: [{ merchandiseId: String(variantId), quantity: 1 }],
            promise: deferred.promise,
          })
        );

        const response = await fetch(`${window.Shopify?.routes?.root ?? '/'}cart/add.js`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            items: [{ id: Number(variantId), quantity: 1 }],
            sections: sectionIds.join(','),
            sections_url: window.location.pathname,
          }),
        });
        const result = await response.json();
        const cart = await (await fetch(`${window.Shopify?.routes?.root ?? '/'}cart.js`)).json();

        deferred.resolve({
          cart: CartLinesUpdateEvent.createCartFromAjaxResponse(cart),
          detail: {
            items: cart.items,
            source: 'botoms-cart-upsell',
            sections: result.sections,
            didError: !response.ok,
          },
        });

        if (!response.ok) message.textContent = result.description || this.dataset.error;
      } catch (error) {
        message.textContent = this.dataset.error;
      } finally {
        button.removeAttribute('aria-busy');
      }
    }
  }

  if (!customElements.get('botoms-cart-upsell')) {
    customElements.define('botoms-cart-upsell', BotomsCartUpsell);
  }
{% endjavascript %}
