{%- doc -%}
  Botoms icon set: Lucide icons (https://lucide.dev), ISC License, Copyright (c) Lucide Contributors 2022.
  Outline icons, 24px grid, 1.6 stroke; colour comes from `currentColor`.

  @param {string} name - heart, share, bag, search, truck, shield-check, rotate-ccw, ruler, palette, link, check
  @param {number} [size] - Width and height in px, default 20
  @param {string} [extra_class] - Extra class names

  @example
  {% render 'botoms-icon', name: 'heart', size: 18 %}
{%- enddoc -%}

{%- assign icon_size = size | default: 20 -%}
<svg
  class="botoms-icon botoms-icon--{{ name }} {{ extra_class }}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case name -%}
    {%- when 'heart' -%}
