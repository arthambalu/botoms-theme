{%- doc -%}
  Compact product card (portrait photo, title, price) used in Botoms product rows.

  @param {product} card_product - The product to show

  @example
  {% render 'botoms-mini-card', card_product: product %}
{%- enddoc -%}

<li class="botoms-mini-card">
  <a class="botoms-mini-card__link" href="{{ card_product.url }}">
    <span class="botoms-mini-card__frame">
      {%- if card_product.featured_image != blank -%}
        {{
          card_product.featured_image
          | image_url: width: 600
          | image_tag: widths: '240, 360, 480, 600', sizes: '(min-width: 750px) 220px, 42vw', loading: 'lazy', alt: '', class: 'botoms-mini-card__image'
        }}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'botoms-mini-card__image' }}
      {%- endif -%}
    </span>
    <span class="botoms-mini-card__title">{{ card_product.title }}</span>
    <span class="botoms-mini-card__price">
      {%- if card_product.compare_at_price > card_product.price -%}
        <span class="botoms-mini-card__sale">{{ card_product.price | money }}</span>
        <s>{{ card_product.compare_at_price | money }}</s>
      {%- else -%}
        {{ card_product.price | money }}
      {%- endif -%}
    </span>
  </a>
</li>

{% stylesheet %}
  .botoms-mini-card {
    scroll-snap-align: start;
  }

  .botoms-mini-card__link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--botoms-ink);
    text-decoration: none;
  }

  .botoms-mini-card__frame {
    display: block;
    aspect-ratio: 3 / 4;
    margin-bottom: 6px;
    overflow: hidden;
    border-radius: 12px;
    background-color: var(--botoms-photo-white);
  }

  .botoms-mini-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .botoms-mini-card__title {
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .botoms-mini-card__price {
    display: flex;
    gap: 6px;
    font-size: 0.875rem;
  }

  .botoms-mini-card__price s {
    color: var(--botoms-muted-ink);
  }

  .botoms-mini-card__sale {
    color: var(--botoms-rose);
  }

  .botoms-mini-card__link:focus-visible {
    outline: 2px solid var(--botoms-forest);
    outline-offset: 4px;
    border-radius: 12px;
  }
{% endstylesheet %}
