{%- doc -%}
  Botoms brand tokens and the few brand styles Horizon has no setting for.
  Values come from brand/brand.md. Palette, fonts, buttons, inputs and swatches live in theme settings.

  @example
  {% render 'botoms-tokens' %}
{%- enddoc -%}

{% style %}
  :root {
    --botoms-pink-cherub: #FDBCC6;
    --botoms-butterfly: #D1E2AE;
    --botoms-tomatillo: #C6E49A;
    --botoms-ink: #24301F;
    --botoms-muted-ink: #5B6655;
    --botoms-forest: #2F4A2B;
    --botoms-rose: #A8355A;
    --botoms-cream: #FBF8F4;
    --botoms-photo-white: #F5F3F0;
    --botoms-line: #E6E1DA;
    --botoms-control: #7D8778;
    --botoms-white: #FFFFFF;
    --botoms-ink-rgb: 36 48 31;
  }

  ::selection {
    background-color: var(--botoms-pink-cherub);
    color: var(--botoms-ink);
  }

  .card-gallery,
  .product-media-container {
    background-color: var(--botoms-photo-white);
  }

  .announcement-bar .announcement-bar__text {
    display: block;
    width: fit-content;
    max-width: calc(100% - 32px);
    align-self: center;
    margin-inline: auto;
    padding: 6px 14px;
    border-radius: 999px;
    background-color: var(--botoms-pink-cherub);
    color: var(--botoms-ink);
  }

  {% if template.name == 'index' %}
    /* Home header: a dark full-width bar with light logo, links and icons and a hairline (sample 2), instead of the pill.
       The header is transparent on home; these keep it dark when it sticks on scroll-up or a menu link is hovered. */
    #header-component.header[transparent] {
      --header-logo-display: none;
      --header-logo-inverse-display: block;
      --color-foreground: var(--botoms-cream);
      --color-foreground-rgb: 251 248 244;
      --color-transparent-text: var(--botoms-cream);
      --color-transparent-text-rgb: 251 248 244;
    }

    #header-component.header[transparent] .header__underlay {
      background-color: var(--botoms-ink);
    }

    #header-component.header .header__row--top {
      width: auto;
      margin: 0;
      border-radius: 0;
      border-bottom: 1px solid rgb(251 248 244 / 0.16);
      box-shadow: none;
    }

    /* Home is dark end to end (Botoms dual hero design). */
    /* Horizon paints section colours on a .section-background layer above the section itself. */
    #header-group > .shopify-section:not(.header-section),
    #header-group > .shopify-section:not(.header-section) .section-background {
      background-color: var(--botoms-ink);
    }

    /* Footer stays dark on home; the pink newsletter card and popovers keep their own colours. */
    .shopify-section.shopify-section-group-footer-group:not(.header-section) .section-background {
      --color-background: var(--botoms-ink);

      background-color: var(--botoms-ink);
    }

    .shopify-section-group-footer-group .section.section--page-width {
      --color-foreground: var(--botoms-cream);
      --color-foreground-rgb: 251 248 244;
      --color-border: rgb(251 248 244 / 0.16);
      --color-border-rgb: 251 248 244;

      color: var(--botoms-cream);
    }

    .shopify-section-group-footer-group .section.section--page-width :is(p, a, li, span, summary, button, h2, h3):not(.email-signup__button) {
      color: inherit;
    }

    /* Copyright and policy blocks set --color-utilities inline from their settings, so set the colour itself. */
    .shopify-section-group-footer-group .utilities :is(.footer-utilities__group-copyright, a, button) {
      color: rgb(251 248 244 / 0.75);
    }

    /* The policy trigger's colour comes from an inline typography style. */
    .shopify-section-group-footer-group .utilities .policy-list-trigger {
      /* stylelint-disable-next-line declaration-no-important */
      color: rgb(251 248 244 / 0.75) !important;
    }

    .shopify-section-group-footer-group .group-block:has(.email-signup__input) {
      color: var(--botoms-ink);
    }

    main [ref='priceContainer'] .compare-at-price ~ .price,
    main [ref='priceContainer'] .price:has(~ .compare-at-price) {
      color: var(--botoms-pink-cherub);
    }

    main h2 em {
      font-family: var(--font-heading--family);
      font-style: italic;
      font-weight: 400;
      color: var(--botoms-pink-cherub);
    }

    /* Horizon text blocks on home: small eyebrow paragraph, sans heading with an italic serif word. */
    main .text-block:has(h2 em) p:first-child {
      margin: 0 0 12px;
      font-family: var(--font-body--family);
      font-size: 11px;
      font-weight: 400;
      line-height: 1.4;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    main .text-block.text-block:has(h2 em) h2 {
      margin: 0;
      font-family: var(--font-body--family);
      font-size: clamp(2.5rem, 9vw, 4.5rem);
      font-weight: 400;
      line-height: 1;
      letter-spacing: -0.03em;
    }
  {% endif %}

  #header-component .header__row--top {
    box-sizing: border-box;
    width: calc(100% - 24px);
    margin: 8px 12px 0;
    border-radius: 999px;
    background-color: var(--botoms-white);
    box-shadow: 0 10px 28px -18px rgb(var(--botoms-ink-rgb) / 0.45);
    transition: box-shadow 0.25s ease, margin 0.25s ease;
  }

  #header-component[data-sticky-state='active'] .header__row--top {
    margin-top: 6px;
    box-shadow: 0 16px 32px -14px rgb(var(--botoms-ink-rgb) / 0.5);
  }

  @media screen and (min-width: 750px) {
    #header-component .header__row--top {
      width: calc(100% - 48px);
      margin: 10px 24px 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #header-component .header__row--top {
      transition: none;
    }
  }

  button.shopify-payment-button__button--unbranded {
    --button-background-color: transparent;
    --button-color: var(--botoms-ink);
    --button-border-color: var(--botoms-ink);
    --button-border-width: 1.5px;
    border-radius: var(--style-border-radius-buttons-secondary);
  }

  button.shopify-payment-button__button--unbranded:hover {
    --button-background-color: var(--botoms-white);
  }

  .footer-utilities .policy-list-trigger {
    color: var(--botoms-muted-ink);
  }

  .slideshow-control {
    min-width: 24px;
    min-height: 24px;
  }

  @media screen and (max-width: 749px) {
    .facets-toggle__wrapper {
      position: fixed;
      inset-inline-start: 50%;
      bottom: calc(16px + env(safe-area-inset-bottom));
      z-index: 4;
      transform: translateX(-50%);
    }

    .facets-toggle__wrapper .facets-toggle__button {
      gap: 8px;
      min-height: 48px;
      padding: 12px 24px;
      border-radius: 999px;
      background-color: var(--botoms-ink);
      color: var(--botoms-white);
      box-shadow: 0 10px 24px -8px rgb(var(--botoms-ink-rgb) / 0.5);
    }

    .facets-toggle__wrapper .facets-toggle__button:focus-visible {
      outline: 2px solid var(--botoms-pink-cherub);
      outline-offset: 3px;
    }
  }

  [ref='priceContainer'] .compare-at-price ~ .price,
  [ref='priceContainer'] .price:has(~ .compare-at-price) {
    color: var(--botoms-rose);
  }

  /* Product page: quantity is changed in the bag (design notes), so Add to bag gets the full row. */
  .product-information .quantity-selector-wrapper,
  .quick-add-modal .quantity-selector-wrapper {
    display: none;
  }

  /* Sold-out sizes: greyed tile behind Horizon's strike line, so they read as unavailable at a glance. */
  .variant-option__button-label:not(.variant-option__button-label--has-swatch):has([data-option-available='false']) {
    background-color: var(--botoms-photo-white);
    color: rgb(var(--botoms-ink-rgb) / 0.4);
  }

  @media screen and (min-width: 750px) {
    .product-information {
      padding-block-start: 24px;
    }

    /* Tablet Shop All: the filter sidebar leaves room for one "medium" card; keep two per row. */
    @container product-grid (max-width: 640px) {
      .product-grid.product-grid--grid:not([product-grid-view='zoom-out']) {
        --product-grid-columns-desktop: repeat(2, minmax(0, 1fr));
      }
    }
  }
{% endstyle %}

{% render 'botoms-size-required' %}
