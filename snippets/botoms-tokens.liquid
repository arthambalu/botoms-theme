{%- doc -%}
  Botoms brand tokens and the few brand styles Horizon has no setting for.
  Values come from brand/brand.md. Palette, fonts, buttons, inputs and swatches live in theme settings.

  @example
  {% render 'botoms-tokens' %}
{%- enddoc -%}

{% style %}
  :root {
    --botoms-pink-cherub: #FDBCC6;
    --botoms-butterfly: #D1E2AE;
    --botoms-tomatillo: #C6E49A;
    --botoms-ink: #24301F;
    --botoms-muted-ink: #5B6655;
    --botoms-forest: #2F4A2B;
    --botoms-rose: #A8355A;
    --botoms-cream: #FBF8F4;
    --botoms-photo-white: #F5F3F0;
    --botoms-line: #E6E1DA;
    --botoms-control: #7D8778;
    --botoms-white: #FFFFFF;
    --botoms-ink-rgb: 36 48 31;
  }

  ::selection {
    background-color: var(--botoms-pink-cherub);
    color: var(--botoms-ink);
  }

  .card-gallery,
  .product-media-container {
    background-color: var(--botoms-photo-white);
  }

  .announcement-bar .announcement-bar__text {
    display: block;
    width: fit-content;
    max-width: calc(100% - 32px);
    align-self: center;
    margin-inline: auto;
    padding: 4px 14px;
    border-radius: 999px;
    background-color: var(--botoms-pink-cherub);
    color: var(--botoms-ink);
  }

  #header-component .header__row--top {
    box-sizing: border-box;
    width: calc(100% - 24px);
    margin: 8px 12px 0;
    border-radius: 999px;
    background-color: var(--botoms-white);
    box-shadow: 0 10px 28px -18px rgb(var(--botoms-ink-rgb) / 0.45);
    transition: box-shadow 0.25s ease, margin 0.25s ease;
  }

  #header-component[data-sticky-state='active'] .header__row--top {
    margin-top: 6px;
    box-shadow: 0 16px 32px -14px rgb(var(--botoms-ink-rgb) / 0.5);
  }

  @media screen and (min-width: 750px) {
    #header-component .header__row--top {
      width: calc(100% - 48px);
      margin: 10px 24px 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #header-component .header__row--top {
      transition: none;
    }
  }

  button.shopify-payment-button__button--unbranded {
    --button-background-color: transparent;
    --button-color: var(--botoms-ink);
    --button-border-color: var(--botoms-ink);
    --button-border-width: 1.5px;
    border-radius: var(--style-border-radius-buttons-secondary);
  }

  button.shopify-payment-button__button--unbranded:hover {
    --button-background-color: var(--botoms-white);
  }

  .footer-utilities .policy-list-trigger {
    color: var(--botoms-muted-ink);
  }

  .slideshow-control {
    min-width: 24px;
    min-height: 24px;
  }

  @media screen and (max-width: 749px) {
    .facets-toggle__wrapper {
      position: fixed;
      inset-inline-start: 50%;
      bottom: calc(16px + env(safe-area-inset-bottom));
      z-index: 4;
      transform: translateX(-50%);
    }

    .facets-toggle__wrapper .facets-toggle__button {
      gap: 8px;
      min-height: 48px;
      padding: 12px 24px;
      border-radius: 999px;
      background-color: var(--botoms-ink);
      color: var(--botoms-white);
      box-shadow: 0 10px 24px -8px rgb(var(--botoms-ink-rgb) / 0.5);
    }

    .facets-toggle__wrapper .facets-toggle__button:focus-visible {
      outline: 2px solid var(--botoms-pink-cherub);
      outline-offset: 3px;
    }
  }

  [ref='priceContainer'] .compare-at-price ~ .price,
  [ref='priceContainer'] .price:has(~ .compare-at-price) {
    color: var(--botoms-rose);
  }

  /* Product page: quantity is changed in the bag (design notes), so Add to bag gets the full row. */
  .product-information .quantity-selector-wrapper,
  .quick-add-modal .quantity-selector-wrapper {
    display: none;
  }

  /* Sold-out sizes: greyed tile behind Horizon's strike line, so they read as unavailable at a glance. */
  .variant-option__button-label:not(.variant-option__button-label--has-swatch):has([data-option-available='false']) {
    background-color: var(--botoms-photo-white);
    color: rgb(var(--botoms-ink-rgb) / 0.4);
  }

  @media screen and (min-width: 750px) {
    .product-information {
      padding-block-start: 24px;
    }
  }
{% endstyle %}

{% render 'botoms-size-required' %}
