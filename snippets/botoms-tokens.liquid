{%- doc -%}
  Botoms brand tokens and the few brand styles Horizon has no setting for.
  Values come from brand/brand.md. Palette, fonts, buttons, inputs and swatches live in theme settings.

  @example
  {% render 'botoms-tokens' %}
{%- enddoc -%}

{% style %}
  :root {
    --botoms-pink-cherub: #FDBCC6;
    --botoms-butterfly: #D1E2AE;
    --botoms-tomatillo: #C6E49A;
    --botoms-ink: #24301F;
    --botoms-muted-ink: #5B6655;
    --botoms-forest: #2F4A2B;
    --botoms-rose: #A8355A;
    --botoms-cream: #FBF8F4;
    --botoms-photo-white: #F5F3F0;
    --botoms-line: #E6E1DA;
    --botoms-control: #7D8778;
    --botoms-white: #FFFFFF;
    --botoms-ink-rgb: 36 48 31;
  }

  ::selection {
    background-color: var(--botoms-pink-cherub);
    color: var(--botoms-ink);
  }

  .card-gallery,
  .product-media-container {
    background-color: var(--botoms-photo-white);
  }

  .announcement-bar .announcement-bar__text {
    display: block;
    width: fit-content;
    max-width: calc(100% - 32px);
    align-self: center;
    margin-inline: auto;
    padding: 6px 14px;
    border-radius: 999px;
    background-color: var(--botoms-pink-cherub);
    color: var(--botoms-ink);
  }

  {% if template.name == 'index' %}
    /* Home: the header floats over the dark hero as the same cream pill used on every page. Horizon clears
       header rows and swaps to the inverse logo in transparent mode, so paint the pill and keep the dark logo. */
    #header-component.header[transparent] {
      --header-logo-display: block;
      --header-logo-inverse-display: none;
    }

    #header-component.header[transparent] .header__row--top {
      isolation: isolate;
    }

    #header-component.header[transparent] .header__row--top::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      border-radius: inherit;
      background-color: var(--botoms-cream);
    }

    /* Below the hero the page is light: italic heading words in Rose for contrast on cream. */
    main h2 em {
      font-family: var(--font-heading--family);
      font-style: italic;
      font-weight: 400;
      color: inherit;
    }

    /* Horizon text blocks on home: small eyebrow paragraph, sans heading with an italic serif word. */
    main .text-block:has(h2 em) p:first-child {
      margin: 0 0 12px;
      font-family: var(--font-body--family);
      font-size: 11px;
      font-weight: 400;
      line-height: 1.4;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    main .text-block.text-block:has(h2 em) h2 {
      margin: 0;
      font-family: var(--font-body--family);
      font-size: clamp(2.5rem, 9vw, 4.5rem);
      font-weight: 400;
      line-height: 1;
      letter-spacing: -0.03em;
    }
  {% endif %}

  #header-component .header__row--top {
    box-sizing: border-box;
    width: calc(100% - 24px);
    margin: 8px 12px 0;
    border-radius: 999px;
    background-color: var(--botoms-white);
    box-shadow: 0 10px 28px -18px rgb(var(--botoms-ink-rgb) / 0.45);
    transition: box-shadow 0.25s ease, margin 0.25s ease;
  }

  #header-component[data-sticky-state='active'] .header__row--top {
    margin-top: 6px;
    box-shadow: 0 16px 32px -14px rgb(var(--botoms-ink-rgb) / 0.5);
  }

  @media screen and (min-width: 750px) {
    #header-component .header__row--top {
      width: calc(100% - 48px);
      margin: 10px 24px 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #header-component .header__row--top {
      transition: none;
    }
  }

  button.shopify-payment-button__button--unbranded {
    --button-background-color: transparent;
    --button-color: var(--botoms-ink);
    --button-border-color: var(--botoms-ink);
    --button-border-width: 1.5px;
    border-radius: var(--style-border-radius-buttons-secondary);
  }

  button.shopify-payment-button__button--unbranded:hover {
    --button-background-color: var(--botoms-white);
  }

  /* Product cards: the "choose options" quick add is a visible, labelled blush pill ("Choose size"),
     not an icon that only expands on desktop hover. */
  product-card button.quick-add__button--choose {
    --quick-add-background: var(--botoms-pink-cherub);
    --quick-add-foreground: var(--botoms-ink);

    width: auto;
    padding-inline: 2px 14px;
    border: 0;
    color: var(--botoms-ink);
    font-size: 0.8125rem;
    opacity: 1;
  }

  /* Product cards: available colours as a white pill over the photo's bottom-left. Ordered straight after
     the photo and pulled up over it with a negative margin, so it works for any photo ratio. The title link
     is display: contents, so the gallery and pill get negative orders instead of everything else a positive one. */
  .product-card__content > .card-gallery {
    order: -2;
  }

  .product-card__content > product-swatches {
    position: relative;
    z-index: 2;
    order: -1;
    display: flex;
    align-items: center;
    align-self: flex-start;
    width: max-content;
    max-width: calc(100% - 64px);
    height: 22px;
    margin: -34px 0 8px 8px;
    padding: 0 3px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.92);
  }

  /* Smaller dots than Horizon's card default (up to 28px). */
  .product-card__content > product-swatches .swatch {
    --max-swatch-size: 14px;
  }

  /* The swatch list keeps a hidden slot for its "+N" counter; a tight gap stops it padding the pill. */
  .product-card__content > product-swatches overflow-list {
    --overflow-list-padding-inline: 0;
  }

  .product-card__content > product-swatches overflow-list::part(list) {
    column-gap: 4px;
  }

  [product-grid-view='zoom-out'] .product-card__content > product-swatches {
    display: none;
  }

  /* The card decides by its own width, not the screen's: narrow cards get the round bag icon and a longer
     colour pill; wide cards get the "Choose size" label and a pill that stops short of it. The swatch list
     folds whatever doesn't fit into "+N", so the two never meet. */
  .product-card__content {
    container: botoms-card / inline-size;
  }

  product-card button.quick-add__button--choose {
    width: var(--quick-add-collapsed-width);
    padding: 0;
    font-size: 0;
  }

  @container botoms-card (min-width: 300px) {
    product-card button.quick-add__button--choose {
      width: auto;
      padding-inline: 2px 14px;
      font-size: 0.8125rem;
    }

    .product-card__content > product-swatches {
      max-width: calc(100% - 160px);
    }
  }

  /* Footer (all pages): brand column, eyebrow menu headings, full-width wordmark. */
  .footer-content .group-block:has(.email-signup__input) {
    border: 1px solid var(--botoms-line);
  }

  .footer-content > jumbo-text {
    grid-column: 1 / -1;
    margin-top: 16px;
  }

  .footer-content .menu__heading__default {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .footer-content .menu__item a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .footer-content h2 em {
    font-family: var(--font-heading--family);
    font-style: italic;
    color: inherit;
  }

  @media screen and (max-width: 749px) {
    /* Mobile header: the logo, account, wishlist and bag must fit one row without touching. */
    #header-component .header-logo__image {
      height: 20px;
      width: auto;
    }
  }

  @media screen and (max-width: 379px) {
    #header-component .header-logo__image {
      height: 17px;
    }
  }

  .footer-utilities .policy-list-trigger {
    color: var(--botoms-muted-ink);
  }

  .slideshow-control {
    min-width: 24px;
    min-height: 24px;
  }

  @media screen and (max-width: 749px) {
    .facets-toggle__wrapper {
      position: fixed;
      inset-inline-start: 50%;
      bottom: calc(16px + env(safe-area-inset-bottom));
      z-index: 4;
      transform: translateX(-50%);
    }

    .facets-toggle__wrapper .facets-toggle__button {
      gap: 8px;
      min-height: 48px;
      padding: 12px 24px;
      border-radius: 999px;
      background-color: var(--botoms-ink);
      color: var(--botoms-white);
      box-shadow: 0 10px 24px -8px rgb(var(--botoms-ink-rgb) / 0.5);
    }

    .facets-toggle__wrapper .facets-toggle__button:focus-visible {
      outline: 2px solid var(--botoms-pink-cherub);
      outline-offset: 3px;
    }
  }

  [ref='priceContainer'] .compare-at-price ~ .price,
  [ref='priceContainer'] .price:has(~ .compare-at-price) {
    color: var(--botoms-rose);
  }

  /* Product page: quantity is changed in the bag (design notes), so Add to bag gets the full row. */
  .product-information .quantity-selector-wrapper,
  .quick-add-modal .quantity-selector-wrapper {
    display: none;
  }

  /* Sold-out sizes: greyed tile behind Horizon's strike line, so they read as unavailable at a glance. */
  .variant-option__button-label:not(.variant-option__button-label--has-swatch):has([data-option-available='false']) {
    background-color: var(--botoms-photo-white);
    color: rgb(var(--botoms-ink-rgb) / 0.4);
  }

  @media screen and (min-width: 750px) {
    .product-information {
      padding-block-start: 24px;
    }

    /* Tablet Shop All: the filter sidebar leaves room for one "medium" card; keep two per row. */
    @container product-grid (max-width: 640px) {
      .product-grid.product-grid--grid:not([product-grid-view='zoom-out']) {
        --product-grid-columns-desktop: repeat(2, minmax(0, 1fr));
      }
    }
  }
{% endstyle %}

{% render 'botoms-size-required' %}
